{
  "expo": {
    "name": "GoGoCar",
    "slug": "gogocar-mobile",
    "owner": "cryptovault852",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gogocar",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cryptovault852.gogocar",
      "infoPlist": {
        "NSUserNotificationUsageDescription": "GoGoCar 需要發送通知，以便及時通知您新消息和車源更新。",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FF6B00"
      },
      "package": "com.cryptovault852.gogocar",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./jpush.plugin.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "81492ef0-cf32-4996-b0fd-ae6aa0bf4a1c"
      },
      "apiBaseUrl": "https://gogocar853.manus.space"
    },
    "updates": {
      "url": "https://u.expo.dev/81492ef0-cf32-4996-b0fd-ae6aa0bf4a1c",
      "checkAutomatically": "ON_LOAD",
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    },
    "runtimeVersion": "1.0.0"
  }
}